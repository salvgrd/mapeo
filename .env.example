DATABASE_URL=postgresql://mapeo@localhost:5432/mapeo

# Defaults for import-osm. Tetuán (Madrid); find yours at openstreetmap.org
# by searching the district and copying the relation id from the URL.
OSM_RELATION=356984
OSM_EXCLUDE=Paseo de la Castellana

# Set to 1 only when the app port is reachable solely through a reverse proxy
# that overwrites X-Forwarded-For. Turns on the per-IP login limit.
TRUST_PROXY=
